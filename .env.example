# ─────────────────────────────────────────────
# Meeting Intelligence — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────
# Options: "ollama" | "openai" | "anthropic" | "gemini"
LLM_PROVIDER=ollama

# ── Ollama (local — no API key needed) ───────
OLLAMA_BASE_URL=http://localhost:11434
# Recommended models for M4 Mac (best to worst for structured extraction):
#   llama3.2:3b  → fastest, best instruction following  (ollama pull llama3.2:3b)
#   llama3.1:8b  → slower but higher quality            (ollama pull llama3.1:8b)
#   mistral      → works but weaker at JSON tasks       (ollama pull mistral)
OLLAMA_MODEL=llama3.2:3b

# ── OpenAI (optional cloud fallback) ─────────
OPENAI_API_KEY=

# ── Anthropic (optional cloud fallback) ──────
ANTHROPIC_API_KEY=

# ── Google Gemini (optional cloud fallback) ──
GEMINI_API_KEY=

# ── Jira Integration ──────────────────────────
# Your Atlassian domain (without https://)
# e.g. mycompany.atlassian.net
JIRA_DOMAIN=

# Atlassian account email
JIRA_EMAIL=

# API token from: https://id.atlassian.com/manage-api-tokens
JIRA_API_TOKEN=

# Jira project key (e.g. PROJ, MIP, DEV)
JIRA_PROJECT_KEY=

# ── Project Persistence ───────────────────────
# "memory" (default) keeps state in-process.
# "mongo" persists project state across backend restarts.
PROJECT_STORAGE_BACKEND=memory

# ── Local App Ports / Origins ─────────────────
API_HOST=127.0.0.1
API_PORT=8000
VITE_PORT=5173
# Optional override for frontend -> backend requests
VITE_API_URL=http://127.0.0.1:8000
# Optional comma-separated override for backend CORS policy
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only required when PROJECT_STORAGE_BACKEND=mongo
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=meeting_intelligence
MONGODB_COLLECTION=projects

# ── LangSmith (optional — for tracing/debugging) ──
# Sign up free at https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=meeting-intelligence
