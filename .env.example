# LLM Provider: "ollama" | "openai" | "anthropic" | "gemini"
LLM_PROVIDER=ollama

# Ollama (default — no key needed, just the base URL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# OpenAI (optional)
OPENAI_API_KEY=

# Anthropic (optional)
ANTHROPIC_API_KEY=

# Google Gemini (optional)
GEMINI_API_KEY=
